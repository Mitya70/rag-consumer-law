# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.

# --- Один OpenAI-совместимый сервис для LLM и удалённых эмбеддингов ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://anymodel.org/v1

# --- Модель для ответов и для оценки (выберите в каталоге сервиса, id модели) ---
LLM_MODEL=
JUDGE_MODEL=ag/gemini-3-flash

# --- Эмбеддинги, участвующие в сравнении ---
# удалённые (через OPENAI_BASE_URL)
EMBED_REMOTE_SMALL=am/nemotron-3-embed-1b
EMBED_REMOTE_LARGE=am/nemotron-3.5-embed-8b
RERANK_MODEL=am/nemotron-3.5-rerank-8b
# локальные (sentence-transformers, ключ не нужен)
EMBED_LOCAL_SMALL=intfloat/multilingual-e5-small
EMBED_LOCAL_LARGE=BAAI/bge-m3
# платная модель OpenAI для сравнения (нужен отдельный ключ и base_url OpenAI); необязательно
EMBED_OPENAI=text-embedding-3-small

# --- Параметры запросов ---
REQUEST_TIMEOUT=60
MAX_RETRIES=5

# Второй оценщик (другое семейство моделей, для проверки согласия)
JUDGE_MODEL_2=am/laguna-xs-2.1

# Вторая (платная) модель-генератор для сравнения с бесплатной LLM_MODEL
LLM_MODEL_2=pg/deepseek-v4.1-flash

# Третий оценщик (медленный, 550B): только для перекрёстной проверки на вопросах, проверенных человеком
JUDGE_MODEL_3=am/nemotron-3-ultra-550b-a55b
